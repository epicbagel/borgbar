#!/bin/bash

# omarchy:summary=Watch Borg/borgmatic backups from the Omarchy bar
# omarchy:group=borgbar
# omarchy:args=<status|run|refresh|logs|doctor>
# omarchy:examples=borgbar status|borgbar run|borgbar refresh

set -uo pipefail

# Two very different costs are at play here, and the split matters.
#
# systemd knows when the timer last fired, when it fires next, and how the last
# run ended. That is local and instant, so it is polled.
#
# Asking the repository what archives exist goes over ssh and takes seconds, so
# it is never polled: it is cached, and only refreshed on demand.

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/borgbar"
CONFIG_FILE="$CONFIG_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/borgbar"
CACHE="$CACHE_DIR/archive.json"

UNIT=borgmatic
CONFIG_YAML=/etc/borgmatic/config.yaml
STALE_HOURS=24          # older than this and the bar says so
SCOPE=""                # auto: --user or system, whichever has the timer

# shellcheck source=/dev/null
[[ -f $CONFIG_FILE ]] && source "$CONFIG_FILE"
mkdir -p "$CONFIG_DIR" "$CACHE_DIR"

have() { command -v "$1" >/dev/null 2>&1; }
die() { echo "borgbar: $*" >&2; exit 1; }

have systemctl || die "systemctl not found"
have jq || die "jq is not installed"

# Whichever scope actually owns the timer. A user timer is the common setup,
# but a system one is just as valid and silently reporting "never" would be
# worse than looking in both places.
scope() {
  [[ -n $SCOPE ]] && { echo "$SCOPE"; return; }
  if systemctl --user cat "$UNIT.timer" >/dev/null 2>&1; then echo "--user"
  elif systemctl cat "$UNIT.timer" >/dev/null 2>&1; then echo ""
  else echo "--user"; fi
}
SC=$(scope)

sc() { systemctl $SC "$@" 2>/dev/null; }

timer_json() {
  sc list-timers "$UNIT.timer" --no-pager --output=json | jq -c '.[0] // {}' 2>/dev/null || echo '{}'
}

# borgmatic can be mid-run without the unit being active, if it was started by
# hand rather than by the timer, so both are worth checking.
#
# Deliberately pgrep -x, matching the process name, not -f against the whole
# command line: -f also matches anything that merely mentions borgmatic - a
# shell editing this file, an editor, a grep - and reports a backup in progress
# when nothing is running.
is_running() {
  local st
  st=$(sc is-active "$UNIT.service")
  [[ $st == active || $st == activating ]] && return 0
  pgrep -x borgmatic >/dev/null 2>&1
}

# How far through the current run borg is — an estimate, and labelled as one
# everywhere it surfaces.
#
# The numerator is exact and nearly free: borgmatic already logs every file it
# adds, so summing those paths costs milliseconds.
#
# The denominator is the guess. borg cannot say how much work a run holds — it
# discovers that as it walks — so this compares the source tree against what
# the last archive already held. Both halves are cached by `refresh`, because
# one walks the tree and the other goes over the network. Without them there is
# no percentage, and the caller gets the byte count on its own rather than a
# number dressed up as certainty.
progress_json() {
  local start added_bytes added_files source_bytes archive_bytes delta
  start=$(sc show "$UNIT.service" -p ExecMainStartTimestamp --value)
  [[ -z $start ]] && { echo '{}'; return; }

  added_files=$(journalctl $SC -u "$UNIT.service" --since "$start" --no-pager -o cat | grep -c "^A ")
  added_bytes=$(journalctl $SC -u "$UNIT.service" --since "$start" --no-pager -o cat |
    sed -n 's/^A //p' | tr '\n' '\0' |
    du -cb --files0-from=- 2>/dev/null | tail -1 | cut -f1)
  [[ -z $added_bytes ]] && added_bytes=0

  source_bytes=$(jq -r '.sourceBytes // 0' "$CACHE" 2>/dev/null || echo 0)
  archive_bytes=$(jq -r '.originalSize // 0' "$CACHE" 2>/dev/null || echo 0)
  # Both halves or nothing. With the archive size missing this would otherwise
  # fall back to the whole source tree and report a run that is 96% done as 3%,
  # which is worse than declining to guess.
  if (( source_bytes > 0 && archive_bytes > 0 && source_bytes > archive_bytes )); then
    delta=$(( source_bytes - archive_bytes ))
  else
    delta=0
  fi

  jq -cn --argjson added "$added_bytes" --argjson files "$added_files" \
    --argjson delta "$delta" \
    '{addedBytes:$added, addedFiles:$files, deltaBytes:$delta,
      estimated: true,
      percent: (if $delta > 0
                then ([100, (100 * $added / $delta)] | min | floor)
                else null end)}'
}

cmd_status() {
  local tj next last active result exitcode finished running=false
  tj=$(timer_json)
  # microseconds on the wire
  next=$(jq -r '(.next // 0) as $n | if $n > 0 and $n < 9999999999999999 then ($n/1000000|floor) else 0 end' <<<"$tj")
  last=$(jq -r '(.last // 0) as $l | if $l > 0 then ($l/1000000|floor) else 0 end' <<<"$tj")

  active=$(sc is-active "$UNIT.timer"); [[ -z $active ]] && active=unknown
  result=$(sc show "$UNIT.service" -p Result --value); [[ -z $result ]] && result=unknown
  exitcode=$(sc show "$UNIT.service" -p ExecMainStatus --value); [[ -z $exitcode ]] && exitcode=-1
  finished=$(date -d "$(sc show "$UNIT.service" -p ExecMainExitTimestamp --value)" +%s 2>/dev/null || echo 0)
  is_running && running=true

  # Prefer the moment the run actually finished; the timer's "last" is when it
  # fired, which for a four minute backup is a visibly different thing.
  local reference=$last
  (( finished > reference )) && reference=$finished

  local now age state
  now=$(date +%s)
  age=$(( reference > 0 ? now - reference : -1 ))

  if [[ $running == true ]]; then state=running
  elif [[ $result != success && $result != unknown ]]; then state=failed
  elif (( exitcode > 0 )); then state=failed
  elif (( age >= 0 && age > STALE_HOURS * 3600 )); then state=stale
  elif (( reference > 0 )); then state=ok
  else state=unknown; fi

  local arch='{}'
  [[ -f $CACHE ]] && arch=$(cat "$CACHE" 2>/dev/null || echo '{}')

  local prog='{}'
  [[ $running == true ]] && prog=$(progress_json)

  local installed=false
  have borgmatic && installed=true

  jq -cn --argjson installed "$installed" --arg state "$state" --arg result "$result" --arg timer "$active" \
    --argjson running "$running" --argjson last "$reference" --argjson next "$next" \
    --argjson age "$age" --argjson exitcode "$exitcode" --argjson stale "$STALE_HOURS" \
    --argjson archive "$arch" --argjson progress "$prog" \
    '{installed:$installed, state:$state, running:$running, result:$result, exitCode:$exitcode,
      timer:$timer, lastRun:$last, nextRun:$next, ageSeconds:$age,
      staleHours:$stale, archive:$archive, progress:$progress}'
}

# The slow one. Never called from the poll loop.
#
# Two of the three things cached here are what makes a progress estimate
# possible at all: how big the source tree is once the excludes are applied,
# and how much the last archive already held. The first walks the tree, the
# second goes over the network, and neither belongs on a ten-second timer.
cmd_refresh() {
  have borgmatic || die "borgmatic is not installed"
  local out name at repo original=0 nfiles=0 source=0

  out=$(timeout 120 borgmatic list --last 1 2>/dev/null) || true
  repo=$(sed -n 's/^\([A-Za-z0-9._-]*\): Listing archives.*/\1/p' <<<"$out" | head -1)
  name=$(grep -oE '^[A-Za-z0-9._-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+' <<<"$out" | tail -1)

  # Sizes are best-effort: a run in progress holds the repository lock, and a
  # missing size costs a percentage, not the widget.
  local info
  info=$(timeout 120 borgmatic info --last 1 --json 2>/dev/null) || true
  if [[ -n $info ]]; then
    original=$(jq -r '(.[0].archives[0].stats.original_size // 0)' <<<"$info" 2>/dev/null || echo 0)
    nfiles=$(jq -r '(.[0].archives[0].stats.nfiles // 0)' <<<"$info" 2>/dev/null || echo 0)
  fi
  [[ -z $original || $original == null ]] && original=0
  [[ -z $nfiles || $nfiles == null ]] && nfiles=0

  # Apparent bytes, the same unit borg reports original_size in, and with the
  # config's own excludes applied. An excluded directory can easily be larger
  # than everything being backed up, so skipping this step can put the
  # denominator out by a wide margin.
  source=$(source_bytes)

  if [[ -n $name ]]; then
    at=$(date -d "$(grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}' <<<"$name" | head -1)" +%s 2>/dev/null || echo 0)
    jq -cn --arg name "$name" --arg repo "${repo:-}" --argjson at "${at:-0}" \
      --argjson original "$original" --argjson nfiles "$nfiles" \
      --argjson source "$source" --argjson checked "$(date +%s)" \
      '{name:$name, repo:$repo, at:$at, originalSize:$original, nfiles:$nfiles,
        sourceBytes:$source, checkedAt:$checked}' >"$CACHE"
    cat "$CACHE"
  else
    jq -cn --argjson source "$source" --argjson checked "$(date +%s)" \
      '{error:"could not read the repository", sourceBytes:$source, checkedAt:$checked}' | tee "$CACHE"
  fi
}

# Apparent size of everything borgmatic would actually read, excludes applied.
source_bytes() {
  local dirs=() excludes=() total=0
  mapfile -t dirs < <(sed -n '/^source_directories:/,/^[a-z]/p' "$CONFIG_YAML" 2>/dev/null |
    sed -n 's/^ *- *//p' | tr -d '"')
  mapfile -t excludes < <(sed -n '/^exclude_patterns:/,/^[a-z]/p' "$CONFIG_YAML" 2>/dev/null |
    sed -n 's/^ *- *//p' | tr -d '"')
  (( ${#dirs[@]} )) || { echo 0; return; }

  local args=()
  local e; for e in "${excludes[@]}"; do [[ -n $e ]] && args+=("--exclude=$e"); done
  total=$(du -sb "${args[@]}" "${dirs[@]}" 2>/dev/null | awk '{s+=$1} END{print s+0}')
  echo "${total:-0}"
}

cmd_run() {
  is_running && { echo "already running"; return 0; }
  sc start "$UNIT.service" && echo started || die "could not start $UNIT.service"
}

cmd_logs() { sc -q status >/dev/null 2>&1; journalctl $SC -u "$UNIT.service" -n "${1:-40}" --no-pager -o short-iso 2>/dev/null; }

cmd_doctor() {
  echo "borgbar diagnostics"
  printf '  borg          %s\n' "$(borg --version 2>/dev/null || echo MISSING)"
  printf '  borgmatic     %s\n' "$(borgmatic --version 2>/dev/null || echo MISSING)"
  printf '  scope         %s\n' "${SC:-system}"
  printf '  timer         %s (%s)\n' "$(sc is-active "$UNIT.timer")" "$(sc is-enabled "$UNIT.timer")"
  printf '  last result   %s\n' "$(sc show "$UNIT.service" -p Result --value)"
  printf '  cache         %s\n' "$([[ -f $CACHE ]] && echo "$CACHE" || echo 'none yet - run: borgbar refresh')"
  echo
  cmd_status | jq .
}

case "${1:-status}" in
status) cmd_status ;;
refresh) cmd_refresh ;;
run) cmd_run ;;
logs) shift; cmd_logs "$@" ;;
doctor) cmd_doctor ;;
*) echo "usage: borgbar <status|run|refresh|logs|doctor>" >&2; exit 2 ;;
esac
